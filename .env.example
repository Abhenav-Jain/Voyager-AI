# Application Settings
ENVIRONMENT=development
HOST=127.0.0.1
PORT=8000

# Supabase Database & Auth (Optional - SQLite is used automatically when blank)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-anon-or-service-role-key

# Generative AI API Keys (Optional - Intelligent Transformer Synthesis is active by default)
GEMINI_API_KEY=
LLAMA_API_KEY=
LLM_PROVIDER=auto

# Local Transformer Engine Configuration
MODELS_DIR=./models_cache
